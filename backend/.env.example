# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------- Flask ----------
# Use long random values in any shared/deployed environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too-use-at-least-32-characters

# Access-token lifetime in minutes (session timeout, NFR-02)
JWT_ACCESS_TOKEN_EXPIRES_MIN=30

# ---------- MySQL ----------
# Laragon / XAMPP default: user root with no password on port 3306
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/file_organizer?charset=utf8mb4

# ---------- File storage ----------
# local = files saved in backend/uploads (development)
# s3    = AWS S3 bucket (fill in the AWS settings below)
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Download links expire after this many seconds
S3_PRESIGNED_URL_EXPIRES_SEC=300

# ---------- Uploads ----------
MAX_UPLOAD_MB=20
STORAGE_QUOTA_MB=1024

# ---------- OCR ----------
# Path to tesseract.exe if it is not on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------- AI ----------
# local  = built-in analyser, no API key needed (default)
# openai = OpenAI GPT (set OPENAI_API_KEY); falls back to local if the API fails
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings for search and similar-document detection:
# local | openai | sentence-transformers (pip install sentence-transformers first)
# After changing this, run:  flask --app run.py reindex
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Similarity (0-1) above which two documents are flagged as "similar"
SIMILARITY_THRESHOLD=0.90
# Classification confidence (0-1) below which the UI asks the user to double-check
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60

# ---------- Background processing ----------
PROCESSING_WORKERS=2
