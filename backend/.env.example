# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------- Flask ----------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me

# ---------- Authentication (JWT) ----------
JWT_SECRET_KEY=change-me-too
# Access-token lifetime in minutes (session timeout after inactivity, NFR-02)
JWT_ACCESS_TOKEN_EXPIRES_MIN=30

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=file_organizer
DB_USER=file_organizer_app
DB_PASSWORD=change-me

# ---------- AWS S3 ----------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Pre-signed download links expire after this many seconds
S3_PRESIGNED_URL_EXPIRES_SEC=300

# ---------- Uploads ----------
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg

# ---------- OCR ----------
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------- AI / NLP ----------
# "openai" or "huggingface"
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Similarity score (0-1) above which two documents are flagged as "similar"
SIMILARITY_THRESHOLD=0.90
# Classification confidence (0-1) below which the user is asked to confirm
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
